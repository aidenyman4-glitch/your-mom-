# Is there a roof over here? Anything not see-through within 2..7 blocks above.
execute unless block ~ ~2 ~ #sunman:see_through run return 1
execute unless block ~ ~3 ~ #sunman:see_through run return 1
execute unless block ~ ~4 ~ #sunman:see_through run return 1
execute unless block ~ ~5 ~ #sunman:see_through run return 1
execute unless block ~ ~6 ~ #sunman:see_through run return 1
execute unless block ~ ~7 ~ #sunman:see_through run return 1
return fail
